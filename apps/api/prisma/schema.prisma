generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum AccountType {
  CHECKING
  SAVINGS
  DIGITAL
  CASH
  CREDIT_CARD
  INVESTMENT
}

enum TransactionStatus {
  CONFIRMED
  PENDING_REVIEW
  DELETED
}

enum TransactionOrigin {
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  DASHBOARD
}

/// A fully isolated tenant: its own users, accounts, categories and
/// transactions. Nothing is ever shared or queried across workspaces.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  aiLogs       AiInteractionLog[]
}

model User {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  name          String
  shortName     String?
  whatsappPhone String    @unique
  email         String?
  passwordHash  String?
  cpf           String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  currency      String       @default("BRL")
  timezone      String       @default("America/Sao_Paulo")
  createdAt     DateTime     @default(now())

  transactions Transaction[]
  aiLogs       AiInteractionLog[]
}

model Category {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name      String
  type      TransactionType
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSubcategory")

  transactions Transaction[]

  @@unique([workspaceId, name, parentId])
}

model Account {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name      String
  bank      String?
  type      AccountType @default(CHECKING)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  transactions Transaction[]
}

model Transaction {
  id              String             @id @default(uuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  userId          String
  user            User               @relation(fields: [userId], references: [id])

  type            TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  description     String
  date            DateTime
  categoryId      String?
  category        Category?          @relation(fields: [categoryId], references: [id])
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id])

  paymentMethod   String?
  isRecurring     Boolean            @default(false)
  isInstallment   Boolean            @default(false)
  installmentNo   Int?
  installmentTotal Int?

  origin          TransactionOrigin
  originalMessage String?
  aiConfidence    Float?
  status          TransactionStatus  @default(CONFIRMED)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aiLogs          AiInteractionLog[]
}

model AiInteractionLog {
  id              String       @id @default(uuid())
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  channel         String
  originalMessage String?
  audioUrl        String?
  transcription    String?
  model           String
  promptVersion   String?
  rawResponse     Json?
  extractedData   Json?
  confidence      Float?

  createdAt       DateTime     @default(now())
}
