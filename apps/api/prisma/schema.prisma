generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum AccountType {
  CHECKING
  SAVINGS
  DIGITAL
  CASH
  CREDIT_CARD
  INVESTMENT
}

enum TransactionStatus {
  CONFIRMED
  PENDING_REVIEW
  DELETED
}

enum TransactionOrigin {
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  DASHBOARD
}

/// A fully isolated tenant: its own users, accounts, categories and
/// transactions. Nothing is ever shared or queried across workspaces.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  aiLogs         AiInteractionLog[]
  budgets        Budget[]
  recurringRules RecurringRule[]
}

model User {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  name          String
  shortName     String?
  whatsappPhone String?   @unique
  email         String    @unique
  passwordHash  String?
  cpf           String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  currency      String       @default("BRL")
  timezone      String       @default("America/Sao_Paulo")
  createdAt     DateTime     @default(now())

  transactions   Transaction[]
  aiLogs         AiInteractionLog[]
  recurringRules RecurringRule[]
  passwordResets PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name      String
  type      TransactionType
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSubcategory")

  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([workspaceId, name, parentId])
}

/// A monthly spending limit for one expense category. Re-evaluated against
/// the current calendar month's spend each time it's read — no rollover,
/// no per-month rows to maintain.
model Budget {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([workspaceId, categoryId])
}

model Account {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name       String
  bank       String?
  type       AccountType @default(CHECKING)
  isDefault  Boolean     @default(false)
  creditLimit Decimal?   @db.Decimal(12, 2) // CREDIT_CARD only: the card's total limit, set manually
  createdAt  DateTime    @default(now())

  transactions   Transaction[]
  recurringRules RecurringRule[]
}

/// A template for a transaction that repeats every month on a fixed day
/// (rent, subscriptions, salary). A daily job creates the month's
/// Transaction once "dayOfMonth" is reached, and stamps lastGeneratedMonth
/// so it's never generated twice for the same month.
model RecurringRule {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])

  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  dayOfMonth  Int
  active      Boolean         @default(true)

  lastGeneratedMonth String? // "yyyy-MM" of the last month a transaction was generated for
  createdAt           DateTime @default(now())
}

model Transaction {
  id              String             @id @default(uuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  userId          String
  user            User               @relation(fields: [userId], references: [id])

  type            TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  description     String
  date            DateTime
  categoryId      String?
  category        Category?          @relation(fields: [categoryId], references: [id])
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id])

  paymentMethod   String?
  isRecurring     Boolean            @default(false)
  isInstallment   Boolean            @default(false)
  installmentNo   Int?
  installmentTotal Int?

  origin          TransactionOrigin
  originalMessage String?
  aiConfidence    Float?
  status          TransactionStatus  @default(CONFIRMED)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aiLogs          AiInteractionLog[]
}

model AiInteractionLog {
  id              String       @id @default(uuid())
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  channel         String
  originalMessage String?
  audioUrl        String?
  transcription    String?
  model           String
  promptVersion   String?
  rawResponse     Json?
  extractedData   Json?
  confidence      Float?

  createdAt       DateTime     @default(now())
}
