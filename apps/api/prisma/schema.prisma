generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum ReportEmailFrequency {
  NONE
  WEEKLY
  MONTHLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum AccountType {
  CHECKING
  SAVINGS
  DIGITAL
  CASH
  CREDIT_CARD
  INVESTMENT
  COFRINHO
}

enum BillStatus {
  PENDING
  PAID
  CANCELED
}

enum KeywordSource {
  MANUAL
  LEARNED
}

enum TransactionStatus {
  CONFIRMED
  PENDING_REVIEW
  DELETED
}

enum TransactionOrigin {
  WHATSAPP_TEXT
  WHATSAPP_AUDIO
  WHATSAPP_PHOTO
  WHATSAPP_FILE
  DASHBOARD
}

/// A fully isolated tenant: its own users, accounts, categories and
/// transactions. Nothing is ever shared or queried across workspaces.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users          User[]
  accounts       Account[]
  categories     Category[]
  transactions   Transaction[]
  aiLogs         AiInteractionLog[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  bills          Bill[]
  categoryKeywords CategoryKeyword[]
  people         Person[]
  savingsGoals SavingsGoal[]
  storedAudios StoredAudio[]
}

model User {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  name          String
  shortName     String?
  whatsappPhone String?   @unique
  email         String    @unique
  passwordHash  String?
  cpf           String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  currency      String       @default("BRL")
  timezone      String       @default("America/Sao_Paulo")
  createdAt     DateTime     @default(now())

  transactions        Transaction[]
  aiLogs              AiInteractionLog[]
  recurringRules      RecurringRule[]
  passwordResets      PasswordResetToken[]
  // Two-factor auth (TOTP). The secret is stored encrypted; recovery codes only as hashes.
  mfaEnabled        Boolean   @default(false)
  mfaSecretEnc      String?
  mfaLastStep       Int?
  mfaRecoveryHashes String[]  @default([])
  mfaFailedAttempts Int       @default(0)
  mfaLockedUntil    DateTime?
  goalContributions GoalContribution[]
  // E-mail when a savings goal is behind, close to its deadline or overdue. On unless the person turns it off.
  goalAlertsEmail Boolean @default(true)
  // When the person last wrote to the bot: WhatsApp only lets us message first within 24h of that.
  lastWhatsappAt DateTime?
  // Weekly summary by WhatsApp: off until the person asks. The key names the last week sent ("W:2026-09-28").
  weeklyWhatsappSummary Boolean @default(false)
  weeklyWhatsappLastKey String?
  // Month-closing e-mail (result vs the month before, categories above their average): off until asked. Key = last month sent ("M:2026-09").
  monthlyReviewEmail   Boolean @default(false)
  monthlyReviewLastKey String?

  // Periodic report by e-mail: off until the person opts in. The key names the last period
  // already sent ("W:2026-09-28" / "M:2026-09"), which makes the daily job idempotent.
  reportEmailFrequency ReportEmailFrequency @default(NONE)
  reportEmailLastKey   String?

  pendingConfirmation PendingConfirmation?
  bills               Bill[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name      String
  type      TransactionType
  parentId  String?
  parent    Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSubcategory")

  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  bills          Bill[]
  keywords       CategoryKeyword[]

  @@unique([workspaceId, name, parentId])
}

/// A monthly spending limit for one expense category. Re-evaluated against
/// the current calendar month's spend each time it's read — no rollover,
/// no per-month rows to maintain.
model Budget {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])

  monthlyLimit Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@unique([workspaceId, categoryId])
}

model Account {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name       String
  bank       String?
  type       AccountType @default(CHECKING)
  isDefault  Boolean     @default(false)
  creditLimit Decimal?   @db.Decimal(12, 2) // CREDIT_CARD only: the card's total limit, set manually
  closingDay Int?
  dueDay     Int?
  createdAt  DateTime    @default(now())

  transactions   Transaction[]
  incomingTransfers Transaction[] @relation("TransferTo")
  recurringRules RecurringRule[]
  bills          Bill[]
}

/// A template for a transaction that repeats every month on a fixed day
/// (rent, subscriptions, salary). A daily job creates the month's
/// Transaction once "dayOfMonth" is reached, and stamps lastGeneratedMonth
/// so it's never generated twice for the same month.
model RecurringRule {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id])

  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String
  dayOfMonth  Int
  active      Boolean         @default(true)

  lastGeneratedMonth String? // "yyyy-MM" of the last month a transaction was generated for
  createdAt           DateTime @default(now())
}

model Transaction {
  id              String             @id @default(uuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  userId          String
  user            User               @relation(fields: [userId], references: [id])

  type            TransactionType
  amount          Decimal            @db.Decimal(12, 2)
  description     String
  date            DateTime
  categoryId      String?
  category        Category?          @relation(fields: [categoryId], references: [id])
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id])
  // Only for TRANSFER: the account the money went to (accountId is the one it left).
  toAccountId     String?
  toAccount       Account?           @relation("TransferTo", fields: [toAccountId], references: [id])

  paymentMethod   String?
  merchant        String?
  isRecurring     Boolean            @default(false)
  isInstallment   Boolean            @default(false)
  installmentNo   Int?
  installmentTotal Int?
  /// Shared by every row of one installment purchase. Null on rows created
  /// before this existed, which are grouped by original message instead.
  installmentGroupId String?
  /// Set on rows created by a file import, so the whole import can be undone.
  importBatchId String?
  /// Who the entry is for or about (spouse, child...), when it is not the account owner.
  personId      String?
  person        Person?   @relation(fields: [personId], references: [id])

  origin          TransactionOrigin
  originalMessage String?
  aiConfidence    Float?
  status          TransactionStatus  @default(CONFIRMED)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  aiLogs          AiInteractionLog[]

  @@index([importBatchId])
  @@index([personId])
}

/// Someone close to the account owner whom entries can be attributed to
/// ("presente pra Marília", "mesada do Pedro"). Not a login: people live
/// inside one workspace, which stays isolated from every other.
model Person {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  relation    String?
  createdAt   DateTime  @default(now())

  transactions Transaction[]

  @@unique([workspaceId, name])
}

/// A word or phrase that decides a category deterministically, ahead of the
/// AI's guess. LEARNED rules are written when the user corrects a category;
/// MANUAL ones are added on the Categorias screen. The keyword is stored
/// normalized (lowercase, no accents, single spaces) so matching is exact.
model CategoryKeyword {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  keyword     String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  source      KeywordSource @default(MANUAL)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, keyword])
}

/// A payable not yet paid (rent, utility, boleto). Distinct from a
/// Transaction: nothing has happened to the money yet. Paying it creates the
/// real EXPENSE transaction and links it back via paymentTransactionId, so
/// reversing that transaction can reopen the bill.
model Bill {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User       @relation(fields: [userId], references: [id])

  description String
  amount      Decimal    @db.Decimal(12, 2)
  dueDate     DateTime
  status      BillStatus @default(PENDING)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id])

  /// When paid, a monthly bill spawns next month's; sourceBillId links them.
  repeatMonthly Boolean  @default(false)
  sourceBillId  String?

  paidAt               DateTime?
  paymentTransactionId String?
  originalMessage      String?
  createdAt            DateTime @default(now())

  @@index([workspaceId, status, dueDate])
}

// One row per inbound Twilio message (keyed by their MessageSid), written
// before any processing starts. Twilio retries a webhook delivery whenever
// it doesn't get a timely 2xx — without this, a retry would re-run the AI
// extraction and register the transaction a second time. `reply` is filled
// in once we know the response, so a retry gets the original answer back
// instead of silently doing nothing (which would make Twilio retry forever).
model WebhookEvent {
  id         String   @id @default(uuid())
  messageSid String   @unique
  reply      String?
  createdAt  DateTime @default(now())
}

// A destructive WhatsApp command (today: "apaga o último lançamento") is
// held here instead of executed immediately — the user gets asked to
// confirm, and the next message either does the action (SIM) or drops it
// (anything else). One row per user: a new destructive command replaces
// whatever was pending, since a stale confirmation from a different
// message would be confusing to act on.
model PendingConfirmation {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  action    String
  payload   Json
  createdAt DateTime @default(now())
}

model AiInteractionLog {
  id              String       @id @default(uuid())
  workspaceId     String?
  workspace       Workspace?   @relation(fields: [workspaceId], references: [id])
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  channel         String
  originalMessage String?
  audioUrl        String?
  transcription    String?
  // The voice message itself (kept for audit and correction), not just Twilio's expiring link.
  audioId         String?
  audio           StoredAudio? @relation(fields: [audioId], references: [id])
  model           String
  promptVersion   String?
  rawResponse     Json?
  extractedData   Json?
  confidence      Float?

  createdAt       DateTime     @default(now())
}

/// A savings goal (a trip, an emergency fund). It tracks money set aside by hand, separate
/// from accounts and transactions, so it never changes a balance or a spending report.
model SavingsGoal {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  deadline     DateTime? @db.Date
  // The last alert sent for this goal ("LATE", "NEAR:2026-12-31", "OVERDUE:2026-12-31"), so the daily job never repeats itself.
  lastAlertKey String?
  lastAlertAt  DateTime?
  createdAt    DateTime  @default(now())

  contributions GoalContribution[]

  @@unique([workspaceId, name])
}

/// Money put into (positive) or taken out of (negative) a goal. Progress is the sum.
model GoalContribution {
  id          String      @id @default(uuid())
  goalId      String
  goal        SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  workspaceId String
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  @@index([goalId])
}

/// The original WhatsApp voice message, kept so an entry can be audited later.
model StoredAudio {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contentType String
  data        Bytes
  createdAt   DateTime  @default(now())

  logs AiInteractionLog[]
}
